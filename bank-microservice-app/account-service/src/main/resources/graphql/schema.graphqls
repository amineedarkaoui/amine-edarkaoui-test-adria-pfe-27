enum AccountStatus {
    ACTIVE
    BLOCKED
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

input CreateAccountInput {
    customerReference: String!
    currency: String
    initialBalance: Float
    status: AccountStatus
}

type Query {
    allAccounts: [Account!]!
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
    updateBalance(id: ID!, balance: Float!): Account!
    creditAccount(id: ID!, amount: Float!): Account!
    debitAccount(id: ID!, amount: Float!): Account!
    transfer(sourceAccountId: ID!, destinationAccountId: ID!, amount: Float!): Boolean!
    updateAccountStatus(id: ID!, status: AccountStatus!): Account!
}
