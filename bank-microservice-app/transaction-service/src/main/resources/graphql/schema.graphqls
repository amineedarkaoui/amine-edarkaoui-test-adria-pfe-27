type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    createdAt: String!
}

input RecordTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
}

input ExecuteTransferInput {
    sourceAccountId: ID!
    destinationAccountId: ID!
    amount: Float!
    currency: String!
    country: String
}

type Query {
    allTransactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccountId(accountId: ID!): [Transaction!]!
}

type Mutation {
    recordTransaction(input: RecordTransactionInput!): Transaction!
    executeTransfer(input: ExecuteTransferInput!): Boolean!
}
